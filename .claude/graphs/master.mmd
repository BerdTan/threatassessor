flowchart TD
    %% ── Input ──────────────────────────────────────────────
    IN[/"📄 before.mmd<br/>(architecture diagram)"/]

    %% ── Seven domains ────────────────────────────────────────
    subgraph PIPELINE["🔁 Analysis Pipeline"]
        direction TB
        P1["ground_truth_generator<br/>(parse + score + techniques + Jev filter)"]
        P2["moe_orchestrator<br/>(MoE critics + synthesis)"]
        P3["report generators<br/>(10 output files)"]
        P1 --> P2 --> P3
    end

    subgraph HARNESS["⚙️ Harness (pipeline controller)"]
        direction TB
        H1["controller.py<br/>(PipelineRequest, run_typed)"]
        H2["stages.py<br/>(Analysis→Report→Quality→Bouncer→AIVSS)"]
        H3["policy_broker.py<br/>(dynamic routing after QualityStage)"]
        H4["event_broker.py<br/>+ sinks (SIEM/Langfuse/Webhook)"]
        H1 --> H2 --> H3
        H2 -.->|"side-effects"| H4
    end

    subgraph FLEET["🤖 Managed Agent Fleet  (OpenShell-inspired supervisor)"]
        direction TB
        F1["ManagedAgent base<br/>(allowed_tools/allowed_endpoints contract<br/>supervisor relay · circuit breaker ≥3→frozen<br/>RunCredentials per-run · confirm_isolation() fail-closed)"]
        F2["TAclawInvestigationAgent<br/>(gate=BLOCK trigger · 5 read_only tools<br/>explicit permitted_agents)"]
        F3["ManagedAgentRegistry<br/>(registry + disk persistence)"]
        F4["ManagedToolRegistry<br/>(fleet catalog · ToolRegistration · risk tiers<br/>permitted_agents · CSA ART tags<br/>get_fleet_posture() → CLEAN/WARN/ELEVATED/VIOLATION)"]
        F1 --> F2 & F3
        F1 --> F4
    end

    subgraph API["🌐 REST API  (FastAPI)"]
        direction TB
        A1["/api/v1/analyze-stream · expert-review<br/>(streaming.py — SSE)"]
        A2["/api/v1/reports/* · detect-trend<br/>(reports.py)"]
        A3["/api/v1/gym/* · brain/*<br/>(gym.py · brain.py)"]
        A4["/api/v1/taclaw/* · enrich · artifact<br/>(taclaw.py · enrich.py · artifact.py)"]
        A5["/api/v1/workspaces · broker · config<br/>(workspaces.py · broker.py · config.py)"]
        A6["/api/v1/agents/fleet-posture · /agents/tools<br/>(platform.py — CISO fleet governance view)"]
    end

    subgraph DASHBOARD["📊 Dashboard  (dashboard.js ~20k LOC)"]
        direction TB
        D1["Assessment: Overview · Threats · Controls<br/>Visualise · Insights · TATB"]
        D2["Security: SOC · MCP · Brain"]
        D3["Platform: SIP (TAclaw · adapters · enrichment)"]
        D4["Reporting: Reports · Benchmarks · Boxing"]
        D5["Workspace: TA-Wiz chat + Graph Search<br/>Harness · Traces"]
    end

    subgraph SKILLS["🛠 Skills  (75+ skills, 8 clusters)"]
        direction LR
        S1["Analysis<br/>rerun-corpus · update-data<br/>qualify-corpus · regen-reports"]
        S2["Quality<br/>tatb-score/loop · check-detect<br/>check-governance · check-jev"]
        S3["Security<br/>mcp-audit · harden-audit<br/>detect-loop · detect-trend"]
        S4["Dev/Health<br/>docs-health · codemap · mmd<br/>recall · gen-blog"]
    end

    subgraph REPORTS["📁 Report Files (per architecture)"]
        R1["00 Exec Dashboard  01 Exec Summary<br/>02 Technical  03 Action Plan<br/>09 Threat Model  10 ADR Report"]
        R2["report/brain/ — ta_brain.json + instances<br/>report/taclaw/ — TAclaw investigation JSONs<br/>report/<agent_id>/ — fleet agent reports"]
    end

    %% ── Cross-domain connections ────────────────────────────
    IN --> PIPELINE
    PIPELINE -->|"ground_truth.json"| HARNESS
    HARNESS -->|"triggers"| PIPELINE
    PIPELINE -->|"produces"| REPORTS
    API -->|"calls"| HARNESS
    API -->|"triggers"| FLEET
    FLEET -->|"writes"| REPORTS
    DASHBOARD -->|"fetches"| API
    DASHBOARD -->|"reads"| REPORTS
    SKILLS -->|"invoke via API / Python"| API
    SKILLS -->|"read/patch"| REPORTS

    %% ── Test coverage table (embedded) ─────────────────────
    subgraph TESTS["🧪 Tests  (~500 total)"]
        direction LR
        T1["test_harness_governance   56<br/>test_harness_event_broker  60<br/>test_harness_aivss         39"]
        T2["test_managed_agent        56<br/>check-managed-agents skill 29 checks (PASS CLEAN)<br/>test_mmd_cleaner           21<br/>test_mitre / concurrent / detect ~325"]
    end

    HARNESS -.->|"covered by"| TESTS
    FLEET -.->|"covered by"| TESTS

