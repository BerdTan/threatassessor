---
title: ThreatAssessor — Harness (pipeline controller + governance + observability)
updated: 2026-10-26
note: "Harness wraps the pipeline. Stage order: Analysis→Report→Quality→Bouncer→AIVSS (API_ONLY); +Critics→SM→OutboundGate (FULL_MOE). PolicyBroker runs after QualityStage. ManagedAgentHarness mirrors this pattern for the fleet (stages planned — Entry 221). New stage: subclass BaseStage in stages.py. New sink: subclass BaseSink in sinks.py."
---
flowchart TD
    %% ── Entry point ────────────────────────────────────────
    API["/api/v1/analyze-stream<br/>/api/v1/expert-review<br/>(streaming.py)"]

    %% ── Controller ─────────────────────────────────────────
    subgraph CTRL["controller.py"]
        C1["ThreatAssessorHarness<br/>(run, scenario config)"]
        C2["PipelineRequest/Response<br/>(typed v2 interface)"]
        C3["AsyncThreatAssessorHarness<br/>(asyncio.to_thread wrapper)"]
        C4["BlockedPipelineError<br/>(raised by BouncerStage)"]
    end

    %% ── Stages (run in order) ───────────────────────────────
    subgraph STAGES["stages.py  (run in sequence)"]
        direction TB
        S1["1. AnalysisStage<br/>→ ThreatAnalysisService<br/>→ ground_truth.json"]
        S2["2. ReportStage<br/>→ threat_report.py<br/>→ 01/02/03/09/10 files"]
        S3["3. QualityStage<br/>→ governance.py guardrail check"]
        S4["4. BouncerStage  ← required=True<br/>reads exploitation.blocked + kill_switch<br/>raises BlockedPipelineError → API 400"]
        S5["5. CriticStage  (FULL_MOE only)<br/>→ moe_orchestrator.py<br/>→ 04/05/06 critic JSONs"]
        S6["6. ScrumMasterStage  (FULL_MOE only)<br/>→ ScrumMasterCritic<br/>→ 07/08 files"]
        S7["7. AIVSSStage<br/>→ harness_aivss.py<br/>→ governance_signals.json"]
        S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7
    end

    %% ── PolicyBroker (dynamic routing) ─────────────────────
    subgraph PB["policy_broker.py  (runs after QualityStage)"]
        PB1["PolicyBroker.decide()<br/>reads GovernanceSignals live"]
        PB2["BrokerDecision<br/>(adjusts blocked_agents<br/>+ model routing before critics)"]
        PB1 --> PB2
    end

    %% ── Registry (critic gating) ────────────────────────────
    subgraph REG["registry.py"]
        R1["CriticRegistry<br/>(enabled/disabled per critic)"]
        R2["CriticDescriptor<br/>(name, cls, governance_tier,<br/>model_key, enabled)"]
        R3["HarnessModelGuardian<br/>(model override per critic)"]
        R1 --> R2
        R1 --> R3
    end

    %% ── Governance (guardrail) ──────────────────────────────
    subgraph GOV["governance.py  (9 injection categories + 3 evasion layers)"]
        G1["GovernanceSignals<br/>(inbound / internal / outbound)"]
        G2["InhouseGovernanceAdapter<br/>(pattern matching)"]
        G3["AGTGovernanceAdapter<br/>(external policy)"]
        G4["AIVSS v4 scorer<br/>harness_aivss.py<br/>→ governance_signals.json"]
        G1 --> G2 & G3
        G2 & G3 --> G4
    end

    %% ── EventBroker (observability) ─────────────────────────
    subgraph EB["event_broker.py"]
        E1["HarnessEvent<br/>(stage_start, stage_end,<br/>critic_result, governance_flag,<br/>error, pipeline_complete)"]
        E2["EventBrokerCritic<br/>(fan-out to subscribers)"]
        E1 --> E2
    end

    %% ── Sinks (event consumers) ─────────────────────────────
    subgraph SINKS["sinks.py"]
        SK1["SiemSink<br/>→ logs/siem.jsonl<br/>(schema translation)"]
        SK2["LangfuseSink<br/>→ Langfuse traces<br/>(7 event type mappings)"]
        SK3["WebhookSink<br/>→ POST to URL<br/>(all events)"]
    end

    %% ── Managed Agent Fleet ─────────────────────────────────
    subgraph FLEET["agents/managed/  (OpenShell supervisor live · ManagedAgentHarness stages planned — Entry 221)"]
        direction TB
        FS["ManagedAgent supervisor  ✅ live<br/>(allowed_tools/allowed_endpoints · supervisor relay<br/>circuit breaker ≥3→frozen · RunCredentials per-run<br/>confirm_isolation() fail-closed)"]
        FT["ManagedToolRegistry  ✅ live<br/>(fleet catalog · ToolRegistration · risk tiers<br/>permitted_agents · get_fleet_posture())"]
        FA["AgentPrepStage  ⬜ planned"]
        FB["AgentExecuteStage  ⬜ planned"]
        FC["AgentAuditStage  ⬜ planned"]
        FD["AgentSynthStage  ⬜ planned"]
        FS --> FT
        FS --> FA --> FB --> FC --> FD
    end

    %% ── Flow ────────────────────────────────────────────────
    API --> CTRL
    CTRL --> STAGES
    S3 -->|"signals"| PB
    PB -->|"adjusts routing before critics"| S5
    REG -->|"gates which critics run"| S5
    GOV -->|"blocks on policy violation"| S3
    STAGES -->|"emits events"| EB
    EB --> SINKS
    FLEET -.->|"mirrors harness pattern"| CTRL

    %% ── Tests ───────────────────────────────────────────────
    subgraph TESTS["Tests"]
        direction LR
        TG["test_harness_governance.py<br/>56 tests → governance.py"]
        TE["test_harness_event_broker.py<br/>60 tests → event_broker + sinks"]
        TA["test_harness_aivss.py<br/>39 tests → harness_aivss"]
        TF["test_managed_agent.py<br/>56 tests → agents/managed/"]
    end

    GOV -.->|"covered by"| TG
    EB -.->|"covered by"| TE
    S7 -.->|"covered by"| TA
    FLEET -.->|"covered by"| TF

