  "attack_paths": [
    {
      "path_id": "AP-001",
      "technique_id": "T1190",
      "technique_name": "Exploit Public-Facing Application",
      "tactic": "Initial Access",
      "target_component": "enrollment_svc",
      "entry_point": "attacker",
      "impact": "Unauthenticated remote execution or unauthorized certificate request on ADCS web enrollment service",
      "likelihood": "Medium",
      "likelihood_rationale": "Web enrollment services exposed externally or to unauthenticated segments present significant attack surface."
    },
    {
      "path_id": "AP-002",
      "technique_id": "T1649",
      "technique_name": "Steal or Forge Authentication Certificates",
      "tactic": "Credential Access",
      "target_component": "adcs_server",
      "entry_point": "workstation",
      "impact": "Domain Administrator escalation via misconfigured certificate templates (ESC1/ESC8)",
      "likelihood": "High",
      "likelihood_rationale": "Misconfigured ADCS certificate templates are frequently exploited for instant privilege escalation."
    },
    {
      "path_id": "AP-003",
      "technique_id": "T1003.003",
      "technique_name": "OS Credential Dumping: NTDS",
      "tactic": "Credential Access",
      "target_component": "ntds",
      "entry_point": "dc01",
      "impact": "Full theft of all domain password hashes and active directory credential database at rest",
      "likelihood": "High",
      "likelihood_rationale": "Once domain controller access is achieved, NTDS extraction is a standard post-exploitation step."
    },
    {
      "path_id": "AP-004",
      "technique_id": "T1558.001",
      "technique_name": "Steal or Forge Kerberos Tickets: Golden Ticket",
      "tactic": "Credential Access",
      "target_component": "krbtgt",
      "entry_point": "dc01",
      "impact": "Indefinite domain persistence and full ticket forgery capabilities across the forest",
      "likelihood": "High",
      "likelihood_rationale": "Compromise of the krbtgt account allows creation of valid TGTs bypassing standard authentication."
    },
    {
      "path_id": "AP-005",
      "technique_id": "T1556.007",
      "technique_name": "Modify Authentication Process: Hybrid Identity",
      "tactic": "Credential Access",
      "target_component": "aad_connect",
      "entry_point": "aad_connect",
      "impact": "Pivot from on-premises Active Directory to cloud Entra ID tenant by abusing Azure AD Connect service accounts",
      "likelihood": "High",
      "likelihood_rationale": "Azure AD Connect carries high privilege in both on-premises AD and cloud Entra ID."
    },
    {
      "path_id": "AP-006",
      "technique_id": "T1078.004",
      "technique_name": "Valid Accounts: Cloud Accounts",
      "tactic": "Initial Access",
      "target_component": "vpn_client",
      "entry_point": "remote_user",
      "impact": "Unauthorized access to internal domain resources across the VPN trust boundary",
      "likelihood": "Medium",
      "likelihood_rationale": "Stolen credentials or compromised VPN user sessions allow initial internal boundary crossing."
    },
    {
      "path_id": "AP-007",
      "technique_id": "T1539",
      "technique_name": "Steal Web Session Cookie",
      "tactic": "Credential Access",
      "target_component": "entra_id",
      "entry_point": "workstation",
      "impact": "Bypass of Conditional Access and MFA to gain unauthorized access to PAM Vault and cloud identities",
      "likelihood": "Medium",
      "likelihood_rationale": "Session hijack and adversary-in-the-middle attacks bypass standard MFA verification."
    },
    {
      "path_id": "AP-008",
      "technique_id": "T1059.001",
      "technique_name": "Command and Scripting Interpreter: PowerShell",
      "tactic": "Execution",
      "target_component": "dc01",
      "entry_point": "admin_ws",
      "impact": "Remote execution of malicious admin commands crossing from workstation zone to domain controllers",
      "likelihood": "High",
      "likelihood_rationale": "PowerShell remoting and management tools are widely permitted between admin workstations and domain controllers."
    }
