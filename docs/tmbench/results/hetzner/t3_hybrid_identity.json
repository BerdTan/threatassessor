  "attack_paths": [
    {
      "path_id": "AP-001",
      "technique_id": "T1556.004",
      "technique_name": "Modify Certificate Templates",
      "tactic": "Persistence",
      "target_component": "adcs_server",
      "entry_point": "admin_ws",
      "impact": "Attacker can request certificates that authenticate as any user, including Domain Admins, bypassing MFA and PAM controls",
      "likelihood": "High",
      "likelihood_rationale": "ADCS misconfigurations are common; admin_ws has high privileges to modify templates."
    },
    {
      "path_id": "AP-002",
      "technique_id": "T1552.004",
      "technique_name": "Private Keys",
      "tactic": "Credential Access",
      "target_component": "ntds",
      "entry_point": "dc01",
      "impact": "Dumping NTDS.dit allows offline cracking of hashes and extraction of krbtgt hash for Golden Ticket attacks",
      "likelihood": "Medium",
      "likelihood_rationale": "Requires initial access to DC; mitigated by LSA protection and restricted admin mode."
    },
    {
      "path_id": "AP-003",
      "technique_id": "T1190",
      "technique_name": "Exploit Public-Facing Application",
      "tactic": "Initial Access",
      "target_component": "enrollment_svc",
      "entry_point": "attacker",
      "impact": "Remote code execution on ADCS server, leading to full compromise of certificate infrastructure",
      "likelihood": "High",
      "likelihood_rationale": "Enrollment Service is often internet-facing and historically vulnerable to CVEs (e.g., Zerologon, ADCS exploits)."
    },
    {
      "path_id": "AP-004",
      "technique_id": "T1550.002",
      "technique_name": "Use Alternate Authentication Material: Pass the Hash",
      "tactic": "Lateral Movement",
      "target_component": "entra_id",
      "entry_point": "aad_connect",
      "impact": "Lateral movement from on-prem DC to Cloud Identity using stolen NTLM hashes",
      "likelihood": "Medium",
      "likelihood_rationale": "AAD Connect syncs credentials; if on-prem is compromised, cloud identity is at risk unless password hash sync is disabled or MFA is enforced."
    },
    {
      "path_id": "AP-005",
      "technique_id": "T1078.004",
      "technique_name": "Valid Accounts: Cloud Accounts",
      "tactic": "Initial Access",
      "target_component": "entra_id",
      "entry_point": "remote_user",
      "impact": "Compromise of user account via credential stuffing or phishing, bypassing on-prem security",
      "likelihood": "High",
      "likelihood_rationale": "Remote users are primary targets for phishing; MFA is a control but not infallible."
    },
    {
      "path_id": "AP-006",
      "technique_id": "T1556.005",
      "technique_name": "Modify Identity Infrastructure: Certificate Services",
      "tactic": "Defense Evasion",
      "target_component": "issuing_ca",
      "entry_point": "adcs_server",
      "impact": "Attacker modifies CA settings to issue rogue certificates or disable CRL checking",
      "likelihood": "Medium",
      "likelihood_rationale": "Requires admin access to ADCS; mitigated by separation of duties."
    },
    {
      "path_id": "AP-007",
      "technique_id": "T1558.003",
      "technique_name": "Steal or Forge Kerberos Tickets: Golden Ticket",
      "tactic": "Persistence",
      "target_component": "krbtgt",
      "entry_point": "dc01",
      "impact": "Creation of forged TGTs to access any resource in the domain without detection",
      "likelihood": "Low",
      "likelihood_rationale": "Requires krbtgt hash; mitigated by regular password rotation and LSA protection."
    },
    {
      "path_id": "AP-008",
      "technique_id": "T1136.003",
      "technique_name": "Create Account: Cloud Account",
      "tactic": "Persistence",
      "target_component": "entra_id",
      "entry_point": "entra_id",
      "impact": "Attacker creates a new admin account in Entra ID for persistent access",
      "likelihood": "Medium",
      "likelihood_rationale": "If global admin credentials are compromised, attacker can create backdoors."
    },
    {
      "path_id": "AP-009",
      "technique_id": "T1059.001",
      "technique_name": "Command and Scripting Interpreter: PowerShell",
      "tactic": "Execution",
      "target_component": "hybrid_agent",
      "entry_point": "hybrid_agent",
      "impact": "Execution of malicious scripts on the hybrid agent to exfiltrate data or modify sync rules",
      "likelihood": "Medium",
      "likelihood_rationale": "Agents often run with high privileges; script execution is a common abuse vector."
    }
  ],
