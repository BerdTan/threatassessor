# ==============================================================================
# ThreatAssessor — Environment Configuration Template
# ==============================================================================
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Validate routing after any change:
#   python3 .claude/skills/check-model-routing/scripts/check-model-routing.py
#
# Quick start (OpenRouter free tier, zero cost):
#   1. OPENROUTER_API_KEY=sk-or-v1-...
#   2. LLM_PROVIDER=openrouter
#   3. python3 .claude/skills/check-model-routing/scripts/check-model-routing.py
#
# ==============================================================================


# ==============================================================================
# ThreatAssessor API Authentication
# ==============================================================================

# API key required for all protected endpoints (TM-API-KEY request header).
# Generate: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated). Leave unset for localhost defaults.
# CORS_ALLOWED_ORIGINS=https://app.example.com


# ==============================================================================
# Primary LLM Provider
# ==============================================================================
# Options: openrouter | bedrock | anthropic | azure
# All analysis critics, SM, MoE orchestrator, and TA-Wiz use this provider
# unless overridden per-agent via AGENT_MODEL_* vars below.

LLM_PROVIDER=openrouter
LLM_FALLBACK_PROVIDERS=openrouter
LLM_VERIFIER_PROVIDER=openrouter


# ==============================================================================
# OpenRouter (Recommended — free tier available)
# ==============================================================================
# Get key: https://openrouter.ai/keys
# Free tier: nvidia/nemotron, google/gemma, meta/llama, google/gemini-flash

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default model for analysis pipeline (free tier):
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Base URL override — use to route through a LiteLLM proxy or any OpenAI-compatible endpoint.
# When set, ALL LLM calls (analysis + embeddings) route through this URL instead of OpenRouter.
# Examples:
#   LiteLLM proxy:         OPENROUTER_BASE_URL=http://localhost:4000
#   Local vLLM/Ollama:     OPENROUTER_BASE_URL=http://localhost:11434/v1
#   Custom OpenRouter:     OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  (default, same as unset)
# Leave unset to use OpenRouter directly (default).
# OPENROUTER_BASE_URL=http://localhost:4000

# Embedding model for MITRE technique similarity search.
# Always OpenRouter. Pre-computed 834-technique cache (2048-dim float16 npz).
# Do not change unless you regenerate the cache (/build-embeddings-cache).
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free


# ==============================================================================
# AWS Bedrock (Alternative primary / high-quality fallback)
# ==============================================================================
# Get key: AWS Console → Bedrock → API Keys (bearer token)
# Uncomment and set LLM_PROVIDER=bedrock to use.

# AWS_BEDROCK_API_KEY=ABSK...
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# When using Bedrock as primary:
# LLM_PROVIDER=bedrock
# LLM_FALLBACK_PROVIDERS=bedrock
# LLM_VERIFIER_PROVIDER=bedrock


# ==============================================================================
# Per-Agent Model Routing (optional overrides)
# ==============================================================================
#
# Each agent can use a different model/provider. Empty string = provider default.
# ${VAR} syntax resolved at settings load — set vars here and reference in
# user_config.json (chatbot/config/user_config.json uses ${AGENT_MODEL_*}).
#
# Format: <provider_prefix>/<model_id>
#   openrouter/anthropic/claude-sonnet-4
#   openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Pipeline agents (all default to LLM_PROVIDER if unset):
# AGENT_MODEL_ARCHITECT=
# AGENT_MODEL_TESTER=
# AGENT_MODEL_RED_TEAM=
# AGENT_MODEL_PURPLE_TEAM=
# AGENT_MODEL_BLACKHAT=
# AGENT_MODEL_SCRUM_MASTER=
# AGENT_MODEL_MOE=
# AGENT_MODEL_THREAT_ANALYST=
# AGENT_MODEL_TA_WIZ=
# AGENT_MODEL_EVENT_DETECTOR=

# TACO companion agent — TACOmini per-mini model overrides.
# TACOminiBrain and TACOminiHarness are currently deterministic (no LLM calls);
# their model vars are reserved and take effect once LLM calls are added (Phase 3).
# TACOminiCritic (Phase 3) is the first non-deterministic mini — set a fast/cheap
# model here to keep critic runs cost-effective.
#
# Recommendation: use a fast/small model for brain (KG lookup context),
# a balanced model for harness (pipeline synthesis), and a capable model for critic.
#
# AGENT_MODEL_TACO_BRAIN=          # reserved — deterministic mini, no LLM calls yet
# AGENT_MODEL_TACO_HARNESS=        # reserved — deterministic mini, no LLM calls yet
# AGENT_MODEL_TACO_CRITIC=openrouter/openrouter/free   # Phase 3 — defaults to free tier

# TATB labeller — MUST be a different model family from the pipeline.
# Purpose: independent verifier for benchmark scoring (avoids shared blind spots).
# Default: Nova Pro (Amazon) when using Bedrock; Gemini Flash when using OpenRouter.
#
# OpenRouter:
AGENT_MODEL_TATB_LABELLER=openrouter/google/gemini-2.0-flash-001
AGENT_MODEL_TATB_LABELLER_FALLBACK=openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#
# Bedrock (uncomment if LLM_PROVIDER=bedrock):
# AGENT_MODEL_TATB_LABELLER=bedrock/us.amazon.nova-pro-v1:0
# AGENT_MODEL_TATB_LABELLER_FALLBACK=bedrock/us.anthropic.claude-haiku-4-20250514-v1:0


# ==============================================================================
# Optional Providers
# ==============================================================================

# Anthropic Direct (alternative to Bedrock):
# ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI:
# AZURE_OPENAI_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Google Vertex AI:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_REGION=us-central1


# ==============================================================================
# Optional Integrations
# ==============================================================================

# Langfuse observability (traces critic calls, AIVSS scores as Score objects):
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000

# OpenAI (legacy — agentic/ examples only, not used by core pipeline):
# OPENAI_API_KEY=sk-...

# Neo4j (advanced graph workflows in agentic/ folder only):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_neo4j_password


# ==============================================================================
# Configuration Profiles
# ==============================================================================
#
# Zero-cost (free tier):
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#   AGENT_MODEL_TATB_LABELLER=openrouter/google/gemini-flash-1.5:free
#
# Production (Bedrock primary, OpenRouter fallback):
#   LLM_PROVIDER=bedrock
#   AWS_BEDROCK_API_KEY=ABSK...
#   AGENT_MODEL_TATB_LABELLER=bedrock/us.amazon.nova-pro-v1:0
#   LLM_FALLBACK_PROVIDERS=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#
# Mixed (Claude via OpenRouter, Gemini for TATB):
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#   AGENT_MODEL_ARCHITECT=openrouter/anthropic/claude-sonnet-4
#   AGENT_MODEL_TATB_LABELLER=openrouter/google/gemini-2.0-flash-001
#
# Validate any profile with:
#   python3 .claude/skills/check-model-routing/scripts/check-model-routing.py
#
# ==============================================================================
